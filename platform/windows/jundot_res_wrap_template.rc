#include "core/version.h"

#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

JUNDOT_ICON ICON platform/windows/jundot_console.ico
1 RT_MANIFEST "platform/windows/jundot.manifest"

1 VERSIONINFO
FILEVERSION     JUNDOT_VERSION_MAJOR,JUNDOT_VERSION_MINOR,JUNDOT_VERSION_PATCH,0
PRODUCTVERSION  JUNDOT_VERSION_MAJOR,JUNDOT_VERSION_MINOR,JUNDOT_VERSION_PATCH,0
FILEOS          4
FILETYPE        1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",        JUNDOT_VERSION_NAME " (Console)"
            VALUE "FileVersion",            JUNDOT_VERSION_NUMBER
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
