#include "core/version.h"

#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

JUNDOT_ICON ICON platform/windows/jundot.ico
1 RT_MANIFEST "platform/windows/jundot.manifest"

1 VERSIONINFO
FILEVERSION     JUNDOT_VERSION_MAJOR,JUNDOT_VERSION_MINOR,JUNDOT_VERSION_PATCH,0
PRODUCTVERSION  JUNDOT_VERSION_MAJOR,JUNDOT_VERSION_MINOR,JUNDOT_VERSION_PATCH,0
FILEOS          4
FILETYPE        1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",            "Jundot Engine"
            VALUE "FileDescription",        JUNDOT_VERSION_NAME
            VALUE "FileVersion",            JUNDOT_VERSION_NUMBER
            VALUE "ProductName",            JUNDOT_VERSION_NAME
            VALUE "Licence",                "MIT"
            VALUE "LegalCopyright",         "(c) 2007-present Juan Linietsky, Ariel Manzur and Jundot Engine contributors"
            VALUE "Info",                   "https://jundotengine.org"
            VALUE "ProductVersion",         JUNDOT_VERSION_FULL_BUILD
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
