<?xml version="1.0"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-jundot-project">
    <comment>Jundot Engine project</comment>
    <sub-class-of type="text/plain"/>
    <icon name="x-jundot-project"/>
    <glob pattern="project.jundot"/>
  </mime-type>

  <mime-type type="application/x-jundot-resource">
    <comment>Jundot Engine resource</comment>
    <icon name="x-jundot-resource"/>
    <glob pattern="*.res"/>
    <glob pattern="*.tres"/>
  </mime-type>

  <mime-type type="application/x-jundot-scene">
    <comment>Jundot Engine scene</comment>
    <icon name="x-jundot-scene"/>
    <glob pattern="*.scn"/>
    <glob pattern="*.tscn"/>
    <glob pattern="*.escn"/>
  </mime-type>

  <mime-type type="application/x-jundot-shader">
    <comment>Jundot Engine shader</comment>
    <sub-class-of type="text/plain"/>
    <icon name="x-jundot-shader"/>
    <glob pattern="*.gdshader"/>
  </mime-type>

  <mime-type type="application/x-gdscript">
    <comment>GDScript script</comment>
    <sub-class-of type="text/plain"/>
    <icon name="x-gdscript"/>
    <glob pattern="*.gd"/>
  </mime-type>
</mime-info>
