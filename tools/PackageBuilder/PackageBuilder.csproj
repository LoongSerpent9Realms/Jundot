<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon />
    <AssemblyName>JundotPackageBuilder</AssemblyName>
    <RootNamespace>JundotPackageBuilder</RootNamespace>
    <StartupObject>JundotPackageBuilder.Program</StartupObject>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0</FileVersion>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <!-- Ensure UTF-8 encoding for source files with CJK characters -->
    <Utf8Output>true</Utf8Output>
  </PropertyGroup>

</Project>
