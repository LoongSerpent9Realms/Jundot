@page "/docs/{doc?}"
@model JundotSite.Pages.DocsModel
@{
    Layout = null;
    var categories = Model.GetDocCategories();
    var currentDoc = Model.CurrentDoc;
    var currentTitle = ViewData["Title"]?.ToString() ?? "文档";
    var currentLanguage = Model.CurrentLanguage;
    var htmlLang = Model.SupportedLanguages.First(l => l.Id == currentLanguage).HtmlLang;
}

<!DOCTYPE html>
<html lang="@htmlLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@currentTitle — Jundot Engine 文档</title>
    <meta name="description" content="Jundot Engine 文档 - 基于 Godot 的 AI 辅助自动迭代游戏引擎">
    <link rel="icon" type="image/png" href="~/images/jundot-icon.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/docs.css" asp-append-version="true" />
