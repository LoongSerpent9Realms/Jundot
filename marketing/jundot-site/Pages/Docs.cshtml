</head>
<body class="docs-page">
    <header class="docs-topbar">
        <div class="docs-topbar-inner">
            <a href="/" class="docs-brand">
                <img src="~/images/jundot-icon.png" alt="Jundot Logo" class="docs-brand-logo" />
                <span class="docs-brand-name">Jundot Engine</span>
                <span class="docs-brand-divider"></span>
                <span class="docs-brand-label">文档</span>
            </a>

            <div class="docs-search">
                <div class="docs-search-box">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <path d="m21 21-4.3-4.3"></path>
                    </svg>
                    <input type="text" placeholder="搜索文档..." id="docs-search-input" />
                    <kbd>/</kbd>
                </div>
            </div>

            <nav class="docs-top-nav">
                <a href="/">首页</a>
                <a href="/docs?lang=@currentLanguage" class="active">文档</a>
                <a href="/#features">特性</a>
                <a href="/#download">下载</a>
                <a href="/About">关于</a>
            </nav>

            <div class="docs-actions">
                <form method="get" action="/docs/@currentDoc" class="docs-language-form">
                    <select name="lang" class="docs-version-select" title="语言选择" onchange="this.form.submit()">
                        @foreach (var language in Model.SupportedLanguages)
                        {
                            <option value="@language.Id" selected="@(language.Id == currentLanguage ? "selected" : null)">@language.Label</option>
                        }
                    </select>
                </form>
                <a href="https://github.com/LoongSerpent9Realms/Jundot" target="_blank" class="docs-github-link" title="GitHub">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                    </svg>
                </a>
            </div>
        </div>
    </header>

    <div class="docs-layout">
        <aside class="docs-sidebar">
            <div class="docs-sidebar-inner">
                <div class="docs-sidebar-section">
                    <div class="docs-sidebar-title">
                        <span>项目</span>
                    </div>
                    <a href="/docs/index?lang=@currentLanguage" class="docs-nav-item @(currentDoc == "index" ? "active" : "")">
                        <span class="docs-nav-icon">📘</span>
                        开始使用
                    </a>
                </div>

                @foreach (var category in categories)
                {
                    <div class="docs-sidebar-section">
                        <div class="docs-sidebar-title">
                            <span>@category.Key</span>
                            <svg class="docs-sidebar-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </div>
                        <div class="docs-sidebar-items">
                            @foreach (var item in category.Value)
                            {
                                <a href="/docs/@item.Id?lang=@currentLanguage" 
                                   class="docs-nav-item @(currentDoc == item.Id ? "active" : "")">
                                    @item.Title
                                </a>
                            }
                        </div>
                    </div>
                }

                <div class="docs-sidebar-section">
                    <div class="docs-sidebar-title">
                        <span>社区</span>
                    </div>
                    <div class="docs-sidebar-items">
                        <a href="/Contact" class="docs-nav-item">联系我们</a>
                        <a href="https://github.com/LoongSerpent9Realms/Jundot/discussions" target="_blank" class="docs-nav-item">
                            论坛讨论
                        </a>
                    </div>
                </div>
            </div>
        </aside>

        <main class="docs-main">
            <div class="docs-content-wrapper">
                <nav class="docs-breadcrumb">
                    <a href="/docs?lang=@currentLanguage">文档</a>
                    <span class="docs-breadcrumb-sep">›</span>
                    <span class="docs-breadcrumb-current">@currentTitle</span>
                </nav>

                <article class="docs-article">
                    @Html.Raw(Model.CurrentDocHtml)
                </article>

                <div class="docs-footer-nav">
                    <div class="docs-footer-prev">
                        <span class="docs-footer-label">上一页</span>
                        <a href="#" id="docs-prev-link">← 上一页</a>
                    </div>
                    <div class="docs-footer-next">
                        <span class="docs-footer-label">下一页</span>
                        <a href="#" id="docs-next-link">下一页 →</a>
                    </div>
                </div>
            </div>

            <aside class="docs-toc-sidebar">
                <div class="docs-toc-inner">
                    <div class="docs-toc-title">本页目录</div>
                    <nav class="docs-toc" id="docs-toc">
                        <a href="#" class="docs-toc-item" data-target="">概览</a>
                    </nav>
                </div>
            </aside>
        </main>
    </div>

    <button class="docs-sidebar-toggle" id="docs-sidebar-toggle" onclick="toggleSidebar()">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
    </button>

    <script>
        function toggleSidebar() {
            document.querySelector('.docs-sidebar').classList.toggle('show');
            document.querySelector('.docs-main').classList.toggle('shifted');
        }

        document.addEventListener('DOMContentLoaded', function() {
            var headings = document.querySelectorAll('.docs-article h2');
            var toc = document.getElementById('docs-toc');
            if (toc && headings.length > 0) {
                toc.innerHTML = '';
                headings.forEach(function(h2, index) {
                    var id = 'section-' + index;
                    h2.id = id;
                    var a = document.createElement('a');
                    a.href = '#' + id;
                    a.className = 'docs-toc-item';
                    a.textContent = h2.textContent;
                    a.addEventListener('click', function(e) {
                        e.preventDefault();
                        h2.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    });
                    toc.appendChild(a);
                });
            }

            var searchInput = document.getElementById('docs-search-input');
            if (searchInput) {
                searchInput.addEventListener('keydown', function(e) {
                    if (e.key === '/') {
                        e.preventDefault();
                        searchInput.focus();
                    }
                    if (e.key === 'Escape') {
                        searchInput.blur();
                    }
                });
            }
        });
    </script>
</body>
</html>
