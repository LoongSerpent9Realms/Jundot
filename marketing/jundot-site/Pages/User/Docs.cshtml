@page
@model JundotSite.Pages.User.DocsModel
@{
    ViewData["Title"] = "文档管理";
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-error">@Model.ErrorMessage</div>
}

<div class="user-docs-layout">
    <aside class="user-docs-sidebar">
        <div class="sidebar-header">
            <h2>文档列表</h2>
            <button id="create-doc-btn" class="btn btn-primary btn-sm" onclick="toggleCreateModal()">+ 新建文档</button>
        </div>

        <div class="language-tabs">
            @foreach (var language in Model.SupportedLanguages)
            {
                <a href="/User/Docs?doc=@Model.CurrentDocId&lang=@language.Id" class="language-tab @(Model.CurrentLanguage == language.Id ? "active" : "")">@language.Label</a>
            }
        </div>

        <div class="docs-list">
            @foreach (var doc in Model.Documents)
            {
                <div class="docs-item-wrapper">
                    <a href="/User/Docs?doc=@doc.Id&lang=@Model.CurrentLanguage" class="docs-item @(Model.CurrentDocId == doc.Id ? "active" : "")">
                        <strong>@doc.Title</strong>
                        <span>@doc.Description</span>
                    </a>
                    @if (!doc.IsBuiltIn)
                    {
                        <button class="btn-delete" onclick="confirmDelete('@doc.Id', '@doc.Title')" title="删除文档">×</button>
                    }
                </div>
            }
        </div>
    </aside>

    <main class="user-docs-editor">
        <div class="editor-header">
            <div>
                <h3>编辑：@Model.CurrentDocTitle <span class="lang-pill">@Model.CurrentLanguageLabel</span></h3>
                <span class="built-in-badge">@(Model.IsCurrentDocBuiltIn ? "内置文档" : "自定义文档")</span>
            </div>
            <div class="editor-actions">
                <a href="/docs/@Model.CurrentDocId?lang=@Model.CurrentLanguage" target="_blank" class="btn btn-secondary">预览</a>
            </div>
        </div>

        <div class="editor-tabs">
            <button class="editor-tab @(Model.ActiveTab == "content" ? "active" : "")" onclick="switchTab('content')">文档内容</button>
            <button class="editor-tab @(Model.ActiveTab == "css" ? "active" : "")" onclick="switchTab('css')">自定义CSS</button>
        </div>

        <div id="tab-content" class="tab-panel @(Model.ActiveTab == "content" ? "active" : "")">
            <form method="post">
                <input type="hidden" asp-for="Input.DocId" />
                <input type="hidden" asp-for="Input.Language" />
                <div class="form-group">
                    <textarea asp-for="Input.Html" class="docs-editor" placeholder="输入文档 HTML 内容..."></textarea>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">保存更改</button>
                    <a href="/docs/@Model.CurrentDocId?lang=@Model.CurrentLanguage" target="_blank" class="btn btn-secondary">打开前台预览</a>
                </div>
            </form>
        </div>

        <div id="tab-css" class="tab-panel @(Model.ActiveTab == "css" ? "active" : "")">
            <form method="post" asp-page-handler="SaveCss">
                <div class="form-group">
                    <textarea asp-for="CustomCss" class="docs-editor css-editor" placeholder="/* 在这里输入自定义CSS，例如：
.docs-article h1 {
    color: #ff6b6b;
}
.docs-callout {
    background: #fff3cd;
}
*/"></textarea>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">保存CSS</button>
                    <button type="button" class="btn btn-secondary" onclick="confirmResetCss()">重置为默认</button>
                    <a href="/docs/@Model.CurrentDocId?lang=@Model.CurrentLanguage" target="_blank" class="btn btn-secondary">打开前台预览</a>
                </div>
            </form>
            <form id="reset-css-form" method="post" asp-page-handler="ResetCss" style="display: none;"></form>
        </div>
    </main>
</div>

<div id="create-modal" class="modal-overlay" style="display: none;">
    <div class="modal-content">
        <div class="modal-header">
            <h3>新建文档</h3>
            <button class="modal-close" onclick="toggleCreateModal()">×</button>
        </div>
        <form method="post" asp-page-handler="Create">
            <div class="form-group">
                <label>页面地址 (Slug)</label>
                <input asp-for="CreateInput.Slug" placeholder="例如: my-guide" class="form-input" />
                <small class="form-hint">只能使用英文、数字和短横线，用于访问 URL</small>
            </div>
            <div class="form-group">
                <label>文档标题</label>
                <input asp-for="CreateInput.Title" placeholder="例如: 我的指南" class="form-input" />
            </div>
            <div class="form-group">
                <label>分类</label>
                <input asp-for="CreateInput.Category" placeholder="例如: 参考" class="form-input" />
            </div>
            <div class="form-group">
                <label>描述</label>
                <input asp-for="CreateInput.Description" placeholder="简短描述" class="form-input" />
            </div>
            <div class="form-group">
                <label>语言</label>
                <select asp-for="CreateInput.Language" class="form-input">
                    @foreach (var lang in Model.SupportedLanguages)
                    {
                        <option value="@lang.Id">@lang.Label</option>
                    }
                </select>
            </div>
            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="toggleCreateModal()">取消</button>
                <button type="submit" class="btn btn-primary">创建</button>
            </div>
        </form>
    </div>
</div>

<form id="delete-form" method="post" asp-page-handler="Delete" style="display: none;">
    <input type="hidden" name="docId" id="delete-doc-id" />
</form>

@section Styles {
    <style>
        body {
            background: #07100f;
        }

        body > main {
            min-height: calc(100vh - 72px);
            padding: 96px 24px 24px;
        }

        body > footer {
            display: none;
        }

        .user-docs-layout {
            display: grid;
            grid-template-columns: 320px minmax(0, 1fr);
            max-width: 1600px;
            margin: 0 auto;
            gap: 24px;
            min-height: calc(100vh - 120px);
            align-items: stretch;
        }

        .user-docs-sidebar {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            display: flex;
            flex-direction: column;
            min-height: 0;
            overflow: hidden;
        }

        .sidebar-header {
            padding: 20px 20px 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #eee;
        }

        .sidebar-header h2 {
            margin: 0;
            font-size: 18px;
            color: #333;
        }

        .btn-sm {
            padding: 6px 12px;
            font-size: 13px;
        }

        .language-tabs {
            display: flex;
            gap: 8px;
            padding: 12px 20px;
            border-bottom: 1px solid #eee;
        }

        .language-tab {
            padding: 4px 10px;
            border-radius: 4px;
            color: #666;
            text-decoration: none;
            font-size: 13px;
            transition: all 0.2s;
        }

        .language-tab:hover {
            background: #f5f5f5;
        }

        .language-tab.active {
            background: #4A90D9;
            color: white;
        }

        .docs-list {
            flex: 1;
            padding: 12px 0;
            overflow-y: auto;
            min-height: 0;
        }

        .docs-item-wrapper {
            display: flex;
            align-items: stretch;
            margin: 0 12px;
            border-radius: 8px;
            overflow: hidden;
        }

        .docs-item {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 4px;
            padding: 12px 14px;
            border-radius: 8px;
            text-decoration: none;
            color: inherit;
            transition: all 0.2s;
        }

        .docs-item:hover {
            background: #f8f9fa;
        }

        .docs-item.active {
            background: #e8f0f8;
            border-left: 3px solid #4A90D9;
        }

        .docs-item strong {
            color: #333;
            font-size: 14px;
        }

        .docs-item span {
            color: #888;
            font-size: 12px;
        }

        .btn-delete {
            background: #fee2e2;
            color: #dc2626;
            border: none;
            border-radius: 0 8px 8px 0;
            padding: 0 12px;
            cursor: pointer;
            font-size: 16px;
            display: flex;
            align-items: center;
            transition: all 0.2s;
        }

        .btn-delete:hover {
            background: #fecaca;
        }

        .user-docs-editor {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            display: flex;
            flex-direction: column;
            min-width: 0;
            min-height: 0;
            overflow: hidden;
        }

        .editor-header {
            padding: 20px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #eee;
            flex-wrap: wrap;
            gap: 12px;
        }

        .editor-header h3 {
            margin: 0;
            font-size: 18px;
            color: #333;
        }

        .lang-pill {
            display: inline-block;
            padding: 2px 8px;
            background: #e8f0f8;
            color: #4A90D9;
            border-radius: 4px;
            font-size: 12px;
            margin-left: 8px;
        }

        .built-in-badge {
            display: inline-block;
            padding: 2px 8px;
            background: #f0fdf4;
            color: #16a34a;
            border-radius: 4px;
            font-size: 12px;
            margin-left: 8px;
        }

        .editor-actions {
            display: flex;
            gap: 10px;
        }

        .editor-tabs {
            display: flex;
            border-bottom: 1px solid #eee;
            padding: 0 24px;
        }

        .editor-tab {
            padding: 12px 20px;
            background: none;
            border: none;
            font-size: 14px;
            color: #666;
            cursor: pointer;
            border-bottom: 2px solid transparent;
            margin-bottom: -1px;
            transition: all 0.2s;
        }

        .editor-tab:hover {
            color: #333;
        }

        .editor-tab.active {
            color: #4A90D9;
            border-bottom-color: #4A90D9;
            font-weight: 500;
        }

        .tab-panel {
            display: none;
            flex: 1;
            flex-direction: column;
            min-height: 0;
            overflow: hidden;
        }

        .tab-panel.active {
            display: flex;
        }

        .tab-panel > form {
            display: flex;
            flex: 1;
            min-height: 0;
            flex-direction: column;
        }

        .tab-panel .form-group {
            flex: 1;
            min-height: 0;
            margin-bottom: 0;
        }

        .css-editor {
            color: #1e3a8a;
        }

        .docs-editor {
            width: 100%;
            height: 100%;
            min-height: 0;
            padding: 20px;
            border: none;
            border-radius: 0;
            font-family: 'Consolas', 'Monaco', monospace;
            font-size: 14px;
            line-height: 1.6;
            resize: vertical;
            box-sizing: border-box;
            color: #111827;
            background: #ffffff;
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-group label {
            display: block;
            margin-bottom: 6px;
            font-weight: 500;
            color: #333;
            font-size: 14px;
        }

        .form-input {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 14px;
            transition: all 0.2s;
        }

        .form-input:focus {
            outline: none;
            border-color: #4A90D9;
        }

        .form-hint {
            display: block;
            margin-top: 4px;
            color: #888;
            font-size: 12px;
        }

        .form-actions {
            display: flex;
            gap: 12px;
            padding: 20px 24px;
            border-top: 1px solid #eee;
            flex-wrap: wrap;
        }

        .btn {
            padding: 10px 20px;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

        .btn-primary {
            background: #4A90D9;
            color: white;
        }

        .btn-primary:hover {
            background: #3a7bc8;
        }

        .btn-secondary {
            background: #f5f5f5;
            color: #666;
        }

        .btn-secondary:hover {
            background: #e8e8e8;
        }

        .alert {
            padding: 12px 16px;
            border-radius: 8px;
            margin-bottom: 20px;
            position: fixed;
            top: 86px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 100;
            max-width: min(680px, calc(100vw - 32px));
        }
    </style>
}

@section Scripts {
<script>
    function confirmDelete(docId) {
        if (confirm('确定要删除这个文档页面吗？此操作不可恢复。')) {
            var form = document.getElementById('delete-form');
            document.getElementById('delete-doc-id').value = docId;
            form.submit();
        }
    }
</script>
}
