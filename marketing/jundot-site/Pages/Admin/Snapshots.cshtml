@page
@model JundotSite.Pages.Admin.SnapshotsModel
@{
    ViewData["Title"] = "文档存档管理";
    Layout = "_AdminLayout";
}

<div class="admin-header">
    <h1>文档存档管理</h1>
    <p>创建、恢复和删除文档的历史存档。每文档最多保存 10 个存档。</p>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-error">@Model.ErrorMessage</div>
}

<div class="admin-card">
    <div class="form-row">
        <div class="form-group">
            <label>选择文档</label>
            <select id="docSelect" class="form-control">
                @foreach (var doc in Model.Documents)
                {
                    <option value="@doc.Id" selected="@(Model.CurrentDocId == doc.Id)">@doc.Title</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label>语言</label>
            <select id="langSelect" class="form-control">
                <option value="zh-CN" selected="@(Model.CurrentLanguage == "zh-CN")">简体中文</option>
                <option value="en" selected="@(Model.CurrentLanguage == "en")">English</option>
            </select>
        </div>
        <div class="form-group" style="display: flex; align-items: flex-end;">
            <button type="button" onclick="loadSnapshots()" class="btn btn-primary">查看存档</button>
        </div>
    </div>
</div>

@if (Model.Snapshots.Any())
{
    <div class="admin-card">
        <h3>「@Model.CurrentDocTitle」的存档列表 <span class="count-badge">@Model.Snapshots.Count / 10</span></h3>
        
        <table class="data-table">
            <thead>
                <tr>
                    <th>存档名称</th>
                    <th>创建时间</th>
                    <th>创建人</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var snapshot in Model.Snapshots)
                {
                    <tr>
                        <td><strong>@snapshot.SnapshotName</strong></td>
                        <td>@snapshot.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@snapshot.CreatedByUsername</td>
                        <td>
                            <div class="btn-group">
                                <form method="post" asp-page-handler="Restore" style="display: inline;">
                                    <input type="hidden" name="snapshotId" value="@snapshot.Id" />
                                    <input type="hidden" name="docId" value="@Model.CurrentDocId" />
                                    <input type="hidden" name="lang" value="@Model.CurrentLanguage" />
                                    <button type="submit" class="btn btn-sm btn-primary" onclick="return confirm('确定要恢复到该存档吗？当前内容会先自动备份。')">恢复</button>
                                </form>
                                <form method="post" asp-page-handler="Delete" style="display: inline;">
                                    <input type="hidden" name="snapshotId" value="@snapshot.Id" />
                                    <input type="hidden" name="docId" value="@Model.CurrentDocId" />
                                    <input type="hidden" name="lang" value="@Model.CurrentLanguage" />
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('确定要删除该存档吗？')">删除</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (Model.HasSearched)
{
    <div class="admin-card">
        <p class="empty-message">暂无存档。点击「创建存档」保存当前文档内容。</p>
    </div>
}

<div class="admin-card">
    <h3>创建存档</h3>
    <p>将当前文档内容保存为新存档。</p>
    <form method="post" asp-page-handler="Create">
        <input type="hidden" name="docId" value="@Model.CurrentDocId" />
        <input type="hidden" name="lang" value="@Model.CurrentLanguage" />
        <div class="form-row">
            <div class="form-group">
                <label>存档名称（可选）</label>
                <input name="snapshotName" class="form-control" placeholder="留空则自动生成 v1, v2..." />
            </div>
            <div class="form-group" style="display: flex; align-items: flex-end;">
                <button type="submit" class="btn btn-primary">创建存档</button>
            </div>
        </div>
    </form>
</div>

<div class="admin-card">
    <h3>当前文档内容预览</h3>
    <div class="doc-preview">
        <pre>@Model.CurrentDocContent</pre>
    </div>
</div>

@section Scripts {
    <script>
        function loadSnapshots() {
            var docId = document.getElementById('docSelect').value;
            var lang = document.getElementById('langSelect').value;
            window.location.href = `/Admin/Snapshots?docId=${docId}&lang=${lang}`;
        }
    </script>
}

@section Styles {
    <style>
        .admin-header {
            margin-bottom: 24px;
        }

        .admin-header h1 {
            margin: 0 0 8px 0;
            font-size: 24px;
            color: #333;
        }

        .admin-header p {
            margin: 0;
            color: #666;
        }

        .count-badge {
            display: inline-block;
            padding: 2px 8px;
            background: #e8f0f8;
            color: #4A90D9;
            border-radius: 4px;
            font-size: 12px;
            margin-left: 8px;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
        }

        .data-table th,
        .data-table td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #eee;
        }

        .data-table th {
            background: #f8f9fa;
            font-weight: 600;
            color: #333;
        }

        .data-table tbody tr:hover {
            background: #f8f9fa;
        }

        .btn-group {
            display: flex;
            gap: 8px;
        }

        .btn-sm {
            padding: 6px 12px;
            font-size: 12px;
        }

        .btn-danger {
            background: #fef2f2;
            color: #dc2626;
            border: 1px solid #fecaca;
        }

        .btn-danger:hover {
            background: #fee2e2;
        }

        .empty-message {
            text-align: center;
            color: #888;
            padding: 40px;
        }

        .doc-preview {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 16px;
            max-height: 300px;
            overflow: auto;
        }

        .doc-preview pre {
            margin: 0;
            white-space: pre-wrap;
            word-break: break-all;
            font-size: 13px;
            color: #333;
        }
    </style>
}
