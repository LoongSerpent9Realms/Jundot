@model JundotSite.Pages.Admin.ReleasesModel
@{
    Layout = "_AdminLayout";
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-error">@Model.ErrorMessage</div>
}

@if (Model.ShowForm)
{
    <div class="admin-card admin-form">
        <h3>@(Model.IsEditing ? "编辑版本" : "新建版本")</h3>
        <form method="post" asp-page-handler="@(Model.IsEditing ? "Edit" : "Create")">
            @if (Model.IsEditing)
            {
                <input type="hidden" asp-for="EditId" />
            }

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Input.VersionNumber"></label>
                    <input asp-for="Input.VersionNumber" placeholder="例如：1.7.4 beta" />
                    <span asp-validation-for="Input.VersionNumber" style="color: #c62828; font-size: 13px;"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.ReleaseDate">发布日期</label>
                    <input asp-for="Input.ReleaseDate" type="datetime-local" />
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Input.Title">标题</label>
                <input asp-for="Input.Title" placeholder="例如：Jundot Engine 1.7.4 beta" />
                <span asp-validation-for="Input.Title" style="color: #c62828; font-size: 13px;"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Description">描述（可选）</label>
                <textarea asp-for="Input.Description" placeholder="版本描述信息"></textarea>
            </div>

            <div class="form-group">
                <label asp-for="Input.DownloadUrl">下载链接（可选）</label>
                <input asp-for="Input.DownloadUrl" placeholder="例如：https://github.com/..." />
                <span asp-validation-for="Input.DownloadUrl" style="color: #c62828; font-size: 13px;"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>状态设置</label>
                    <div class="checkbox-inline" style="margin-bottom: 10px;">
                        <input type="checkbox" asp-for="Input.IsPublished" id="isPublished" />
                        <label for="isPublished" style="margin: 0; font-weight: normal;">已发布（在网站上显示）</label>
                    </div>
                    <div class="checkbox-inline">
                        <input type="checkbox" asp-for="Input.IsBeta" id="isBeta" />
                        <label for="isBeta" style="margin: 0; font-weight: normal;">Beta 版本</label>
                    </div>
                </div>
                <div></div>
            </div>

